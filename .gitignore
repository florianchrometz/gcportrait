# SPDX-License-Identifier: MIT
# Per-user assistant settings (machine-specific).
.claude/

# Node / pnpm
node_modules/
.pnpm-store/
*.tsbuildinfo

# Build output: only directories at the root or directly under a workspace package, never src/**
/dist/
/build/
/*/dist/
/*/build/
/packages/*/dist/
/packages/*/build/
coverage/
.vite/
.astro/
website/dist/
# The compiled asset catalog: written by `pnpm catalog:build` (also run by `pnpm install` and before lint,
# typecheck and test), never committed; `pnpm catalog:check` fails if a file here is tracked.
packages/catalog/src/generated/

# Test artefacts
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
*.log

# Local environment
.env
.env.*
!.env.example

# OS noise
.DS_Store
Thumbs.db

# Scratch output from `pnpm render` and screenshot runs
/out/
*.local.png
*.local.svg
