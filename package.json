{
  "name": "gcportrait",
  "version": "1.0.1",
  "private": true,
  "description": "A portrait of your Google Cloud environment: architecture diagrams from Cloud Asset Inventory data.",
  "license": "Apache-2.0",
  "author": "Florian Chrometz",
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": "^22.22.2"
  },
  "scripts": {
    "prepare": "pnpm run catalog:build",
    "dev": "pnpm --parallel --filter @gcportrait/frontend --filter @gcportrait/backend run dev",
    "dev:demo": "pnpm --filter @gcportrait/frontend run dev:demo",
    "demo:static": "node scripts/static-demo.mjs",
    "e2e": "pnpm --filter @gcportrait/e2e run test",
    "build": "pnpm -r --if-present run build",
    "build:app": "pnpm -r --if-present --filter \"!@gcportrait/website\" run build",
    "prelint": "pnpm run catalog:build --quiet",
    "lint": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "pretypecheck": "pnpm run catalog:build --quiet",
    "typecheck": "tsc -b && pnpm --silent --filter @gcportrait/website run typecheck:astro",
    "pretest": "pnpm run catalog:build --quiet",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm --filter @gcportrait/model --filter @gcportrait/ingest --filter @gcportrait/graph --filter @gcportrait/layout --workspace-concurrency=1 exec vitest run --coverage",
    "test:infra": "vitest run --project tooling scripts/infra",
    "catalog:build": "pnpm --silent --filter @gcportrait/catalog run build",
    "catalog:check": "pnpm --silent --filter @gcportrait/catalog run check",
    "catalog:coverage": "pnpm --silent --filter @gcportrait/catalog run coverage",
    "catalog:fetch-official": "node scripts/catalog-fetch-official.mjs",
    "render-scene": "pnpm --silent --filter @gcportrait/graph run render-scene",
    "render": "pnpm --silent --filter @gcportrait/render-cli run render",
    "provenance": "node scripts/check-provenance.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "media": "node scripts/media.mjs",
    "website:dev": "pnpm --filter @gcportrait/website run dev",
    "website:build": "pnpm --filter @gcportrait/website run build",
    "website:preview": "pnpm --filter @gcportrait/website run preview",
    "website:check": "pnpm --filter @gcportrait/website run check",
    "website:lighthouse": "pnpm --filter @gcportrait/website run lighthouse",
    "website:mobile": "pnpm --filter @gcportrait/website run mobile",
    "docker:build": "docker build -f infra/Dockerfile --build-arg APP_VERSION=local -t gcportrait:local .",
    "docker:run": "docker compose -f infra/compose.yaml up",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run catalog:check && pnpm run provenance && pnpm run licenses",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "agents:setup": "node scripts/agents-setup.mjs",
    "release:version": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "prettier": "catalog:",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
