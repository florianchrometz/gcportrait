---
import Base from '../layouts/Base.astro';
import { changelogFiles, releasedSections, unreleased } from '../lib/changelog.js';
import { socialImage } from '../lib/media.js';
import { breadcrumbLd } from '../lib/seo.js';
import { REPOSITORY_URL, repositoryFileUrl } from '../site.js';

const pending = unreleased();
const released = releasedSections(changelogFiles());
const meta = {
  title: 'Changelog',
  description:
    'What changed in gcportrait, release by release, from the project’s changesets: the timeline, export, demo mode, self-hosting and the asset catalog.',
  path: '/changelog/',
  socialImage: socialImage('changelog', 'The gcportrait changelog'),
  jsonLd: [breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Changelog', path: '/changelog/' }])],
};
const kindLabel = { major: 'Major', minor: 'Minor', patch: 'Patch' } as const;
---

<!-- SPDX-License-Identifier: MIT -->
<Base meta={meta}>
  <div class="container changelog">
    <h1>Changelog</h1>
    <p class="lead">
      Every change is recorded as a changeset in the repository; a release turns them into the notes of a
      <a href={`${REPOSITORY_URL}/releases`}>GitHub release</a>, and the container image is published as
      <code class="code-long">ghcr.io/florianchrometz/gcportrait</code>.
    </p>

    <section aria-labelledby="unreleased">
      <h2 id="unreleased">Unreleased</h2>
      {
        pending.length === 0 ? (
          <p class="muted">Nothing is pending: everything is in a release.</p>
        ) : (
          <>
            <p class="muted">
              {pending.length} changes not in a release yet (the <a href={repositoryFileUrl('.changeset', 'tree')}>pending changesets</a>).
            </p>
            <ol class="entries">
              {pending.map((entry) => (
                <li class="entry">
                  <p class="entry-meta">
                    <span class={`badge badge-${entry.kind}`}>{kindLabel[entry.kind]}</span>
                    <span class="muted">{entry.packages.map((name) => name.replace('@gcportrait/', '')).join(', ')}</span>
                  </p>
                  <div class="prose" set:html={entry.html} />
                </li>
              ))}
            </ol>
          </>
        )
      }
    </section>

    {
      released.map((section) => (
        <section aria-labelledby={`v${section.version.replace(/\./g, '-')}`}>
          <h2 id={`v${section.version.replace(/\./g, '-')}`}>{section.version}</h2>
          <ol class="entries">
            {section.entries.map((entry) => (
              <li class="entry">
                <p class="entry-meta">
                  <span class={`badge badge-${entry.kind}`}>{kindLabel[entry.kind]}</span>
                </p>
                <div class="prose" set:html={entry.html} />
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .changelog {
    padding-top: 2rem;
  }
  .entries {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: var(--text-width);
  }
  .entry {
    padding-block: 1rem;
    border-top: 1px solid var(--color-border);
  }
  .entry-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
  }
  .entry .prose :last-child {
    margin-bottom: 0;
  }
  .badge {
    display: inline-block;
    padding: 0.05rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-weight: 500;
    color: var(--color-text);
  }
  .badge-major {
    background: var(--color-tint-subnet);
  }
  .badge-minor {
    background: var(--color-tint-vpc);
  }
  .badge-patch {
    background: var(--color-tint-folder);
  }
</style>
