{
  "name": "@gcportrait/website",
  "version": "1.0.0",
  "private": true,
  "description": "gcportrait website (Astro, static): landing page, docs rendered from docs/, catalog coverage, sample exports.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "tsx scripts/check-site.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "mobile": "tsx scripts/mobile.ts",
    "fillable": "tsx scripts/fillable.ts",
    "stars": "tsx scripts/stars.ts",
    "demo": "tsx scripts/demo.ts",
    "analytics": "tsx scripts/analytics.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b && pnpm run typecheck:astro",
    "typecheck:astro": "tsx scripts/astro-check.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@gcportrait/catalog": "workspace:*",
    "@gcportrait/model": "workspace:*",
    "@telemetrydeck/sdk": "2.0.4",
    "astro": "7.3.5",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "gifenc": "1.0.3",
    "mediabunny": "1.60.0",
    "playwright": "1.64.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
