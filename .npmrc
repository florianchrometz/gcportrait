# SPDX-License-Identifier: MIT
#
# pnpm settings for the gcportrait monorepo. pnpm's defaults already cover most monorepo needs
# (auto-install-peers=true, strict-peer-dependencies=false, link-workspace-packages=false), so only
# deviations from the defaults are listed here.

# Refuse to install on a Node version outside the "engines" ranges (root and dependencies). Node 22 LTS is
# the supported runtime (ADR 0002); a wrong local Node fails at install time instead of with odd runtime errors.
engine-strict=true

# Run package scripts through pnpm's cross-platform shell emulator so that scripts such as
# `VITE_DEMO=1 pnpm ...` and `a && b` behave the same on Windows, macOS and Linux.
shell-emulator=true
