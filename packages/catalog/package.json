{
  "name": "@gcportrait/catalog",
  "version": "1.0.1",
  "private": true,
  "description": "gcportrait asset catalog: product and lens data, the relation-rule engine, the compiler and the coverage check.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsx tooling/build.ts",
    "check": "tsx tooling/check.ts",
    "coverage": "tsx tooling/coverage.ts",
    "prelint": "tsx tooling/build.ts --quiet",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "tsx tooling/build.ts --quiet",
    "typecheck": "tsc -b",
    "pretest": "tsx tooling/build.ts --quiet",
    "test": "vitest run"
  },
  "dependencies": {
    "@gcportrait/model": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "tsx": "catalog:",
    "yaml": "^2.9.1"
  }
}
