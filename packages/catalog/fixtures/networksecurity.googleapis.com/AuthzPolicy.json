[
  {
    "name": "//networksecurity.googleapis.com/projects/demo-app-1/locations/europe-west3/authzPolicies/internal-api-authz",
    "assetType": "networksecurity.googleapis.com/AuthzPolicy",
    "parent": "//cloudresourcemanager.googleapis.com/projects/10000000002",
    "ancestors": [
      "projects/10000000002",
      "folders/20000000002",
      "folders/20000000001",
      "organizations/30000000001"
    ],
    "location": "europe-west3",
    "updateTime": "2026-10-01T08:00:00Z",
    "data": {
      "name": "projects/demo-app-1/locations/europe-west3/authzPolicies/internal-api-authz",
      "description": "Partner calls to the internal API go through the authorization extension",
      "target": {
        "loadBalancingScheme": "INTERNAL_MANAGED",
        "resources": [
          "https://www.googleapis.com/compute/v1/projects/demo-app-1/regions/europe-west3/forwardingRules/internal-api"
        ]
      },
      "action": "CUSTOM",
      "customProvider": {
        "authzExtension": {
          "resources": ["projects/demo-app-1/locations/europe-west3/authzExtensions/partner-authz"]
        }
      },
      "httpRules": [
        {
          "to": {
            "operations": [
              {
                "paths": [
                  {
                    "prefix": "/partner/"
                  }
                ]
              }
            ]
          }
        }
      ],
      "createTime": "2026-04-14T10:20:00.000000000Z",
      "updateTime": "2026-09-28T07:45:00.000000000Z"
    }
  },
  {
    "name": "//networksecurity.googleapis.com/projects/demo-app-1/locations/europe-west3/authzPolicies/egress-deny",
    "assetType": "networksecurity.googleapis.com/AuthzPolicy",
    "parent": "//cloudresourcemanager.googleapis.com/projects/10000000002",
    "ancestors": [
      "projects/10000000002",
      "folders/20000000002",
      "folders/20000000001",
      "organizations/30000000001"
    ],
    "location": "europe-west3",
    "updateTime": "2026-10-01T08:00:00Z",
    "data": {
      "name": "projects/demo-app-1/locations/europe-west3/authzPolicies/egress-deny",
      "description": "Blocks a range of the app subnet at the Secure Web Proxy",
      "target": {
        "resources": ["projects/demo-app-1/locations/europe-west3/gateways/egress-swp"]
      },
      "action": "DENY",
      "httpRules": [
        {
          "from": {
            "sources": [
              {
                "ipBlocks": [
                  {
                    "prefix": "10.10.8.0",
                    "length": 24
                  }
                ]
              }
            ]
          },
          "when": "request.host.endsWith('.example.net')"
        }
      ],
      "createTime": "2026-04-14T10:20:00.000000000Z",
      "updateTime": "2026-09-28T07:45:00.000000000Z"
    }
  }
]
