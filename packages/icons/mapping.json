  "legibility16": [
    {
      "subject": "VM instance",
      "key": "compute_engine",
      "decision": "official",
      "note": "Core colour mark: the chip outline and pins stay distinct at 16 px; kept."
    },
    {
      "subject": "GKE pod (and every Kubernetes object)",
      "key": "google_kubernetes_engine",
      "decision": "official",
      "note": "Core colour mark: the inner cube softens at 16 px, the four-colour hexagon stays recognisable; kept. Google ships no pod glyph; a pod-specific own drawing would need a catalog icon override and is not drawn."
    },
    {
      "subject": "Firewall rule and firewall policy",
      "key": "cloud_firewall_rules",
      "decision": "official",
      "note": "Legacy two-tone brick wall: the courses stay separate at 16 px; kept."
    },
    {
      "subject": "Subnetwork (and VPC network)",
      "key": "virtual_private_cloud",
      "decision": "official",
      "note": "Legacy two-tone node ring: the four nodes and links stay distinct at 16 px; kept. Subnets share the VPC glyph; the zone tint and title tell them apart."
    },
    {
      "subject": "Service account",
      "key": "service_account",
      "decision": "own",
      "note": "No Google glyph exists for a service account in the three sets; own drawing (person with a machine badge), legible at 16 px."
    }
  ]
}
