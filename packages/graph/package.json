{
  "name": "@gcportrait/graph",
  "version": "1.0.1",
  "private": true,
  "description": "gcportrait graph core: Snapshot + asset catalog → Graph (containment, relation edges, indexes, dangling references, Shared VPC), the timeline diff, and Graph + ViewSpec → Scene (lenses, focus views, filters, drill-in, detail levels).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "prelint": "pnpm --silent --filter @gcportrait/catalog run build --quiet",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "pnpm --silent --filter @gcportrait/catalog run build --quiet",
    "typecheck": "tsc -b tsconfig.json test/tsconfig.json scripts/tsconfig.json",
    "pretest": "pnpm --silent --filter @gcportrait/catalog run build --quiet",
    "test": "vitest run",
    "prerender-scene": "pnpm --silent --filter @gcportrait/catalog run build --quiet",
    "render-scene": "tsx scripts/render-scene.ts",
    "pretest:budget": "pnpm --silent --filter @gcportrait/catalog run build --quiet",
    "test:budget": "GCPORTRAIT_GRAPH_BUDGET=strict vitest run test/performance.test.ts --silent=false"
  },
  "dependencies": {
    "@gcportrait/catalog": "workspace:*",
    "@gcportrait/model": "workspace:*"
  },
  "devDependencies": {
    "@gcportrait/demo-data": "workspace:*",
    "@gcportrait/ingest": "workspace:*",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "tsx": "catalog:"
  }
}
