{
  "name": "@gcportrait/model",
  "version": "1.0.1",
  "private": true,
  "description": "Shared domain types and zod schemas for gcportrait.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./testing/fast-check-seed": {
      "types": "./src/testing/fast-check-seed.ts",
      "default": "./src/testing/fast-check-seed.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "fast-check": "catalog:"
  }
}
