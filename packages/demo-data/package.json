{
  "name": "@gcportrait/demo-data",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic synthetic Google Cloud organisations (S, M, L, XL) with a 35-day history for gcportrait's demo mode and tests.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b . scripts",
    "test": "vitest run",
    "generate": "tsx scripts/generate.ts",
    "fixtures": "tsx scripts/generate.ts --fixtures"
  },
  "dependencies": {
    "@gcportrait/model": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:"
  }
}
