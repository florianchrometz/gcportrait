{
  // The headless renderer's command line: Node tooling (fs, pixelmatch, pngjs) around the render library
  // (`@gcportrait/render`, which draws with the frontend's SVG components). Sources and tests are one project. At
  // run time tsx compiles the frontend's files with the frontend's own tsconfig (the `render` script), and Vitest
  // with the frontend's nearest tsconfig.
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src", "test"],
  "references": [
    { "path": "../model" },
    { "path": "../demo-data" },
    { "path": "../graph" },
    { "path": "../render" }
  ]
}
