{
  "name": "@gcportrait/ingest",
  "version": "1.0.0",
  "private": true,
  "description": "Streaming Cloud Asset Inventory ingestion for gcportrait: NDJSON line reader, normaliser, project index and snapshot assembly.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b tsconfig.json test/tsconfig.json",
    "test": "vitest run",
    "test:budget": "GCPORTRAIT_INGEST_BUDGET=strict vitest run test/worker-budget.test.ts --silent=false"
  },
  "dependencies": {
    "@gcportrait/model": "workspace:*"
  },
  "devDependencies": {
    "@gcportrait/demo-data": "workspace:*",
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15"
  }
}
