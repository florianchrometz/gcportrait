# SPDX-License-Identifier: MIT
#
# Environment of the gcportrait backend (backend/src/config.ts parses it once at start-up, with zod).
# Copy to backend/.env for local development: `pnpm dev` loads it if present (.env is git-ignored).
# On Cloud Run the same variables are set on the service; nothing here is a secret, and no credential
# is ever configured through the environment (the backend uses the caller's token or its own ADC identity).
# Blank values mean "use the default".

# TCP port to listen on. Cloud Run sets it. Default: 8080.
PORT=8080

# Interface to bind. Default: 0.0.0.0 (all interfaces, as a container needs). `pnpm dev` uses localhost.
HOST=

# pino log level: fatal | error | warn | info | debug | trace | silent. Default: info.
LOG_LEVEL=info

# json (one JSON object per line, for Cloud Logging) or pretty (human-readable, development only; needs the
# pino-pretty dev dependency). Default: json. `pnpm dev` uses pretty.
LOG_FORMAT=

# Public Google OAuth 2.0 web client id the SPA uses for "Sign in with Google" (the browser's token client,
# Google Identity Services). Unset: sign-in is shown as not configured. Only the id: the client's
# secret is never used. Its authorised JavaScript origins must list this instance's address; it needs no
# redirect URI (docs/self-host-options.md, "The OAuth client in detail"). Form: <project number>-<random>.apps.googleusercontent.com
OAUTH_CLIENT_ID=

# "true" (exactly) enables service-account mode (docs/permissions.md); anything else, or unset,
# leaves it off. A value other than "true" or "false" is reported as a warning at start-up.
SA_MODE_ENABLED=false

# Service-account mode's identity: Application Default Credentials, resolved at start-up (start-up stops with a
# message when they are not usable). On Cloud Run, the service account the service runs as (metadata server). On a
# laptop, run `gcloud auth application-default login --impersonate-service-account=BACKEND_SA_EMAIL` (your account
# needs roles/iam.serviceAccountTokenCreator on it), or point GOOGLE_APPLICATION_CREDENTIALS at such a file. A
# person's own credentials are refused. Not a variable of this service: ADC reads it (backend/README.md,
# "Service-account mode").
# GOOGLE_APPLICATION_CREDENTIALS=

# "true" (exactly) adds the strict exposure check to the service-account gate: a scope whose details the service
# account can read on its own (public, or granted more than roles/cloudasset.viewer) is refused. Off by default;
# with it off, a scope whose details are public passes the gate for everyone signed in (docs/permissions.md). A
# value other than "true" or "false" stops start-up (a typo must not leave the check off).
SA_MODE_STRICT_EXPOSURE=false

# Email of the backend's service account, shown to users so they can grant it roles/cloudasset.viewer.
# Form: <account name>@<project id>.iam.gserviceaccount.com
# With service-account mode on it is optional: the account Application Default Credentials resolve to is
# published, and a different value here stops start-up.
BACKEND_SA_EMAIL=

# Who runs this instance (a person or an organisation), shown on the Connect page before sign-in as "Hosted by
# <HOSTED_BY>." (`hostedBy` in /api/config). Plain text on one line, at most 80 characters; it may not name
# Google.
# Unset: no such line (`hostedBy` is null).
HOSTED_BY=

# Directory of the built SPA (must contain index.html). Default: ../frontend/dist relative to the backend
# package. When it is missing the backend serves only the API (development: Vite serves the SPA).
STATIC_DIR=

# Number of reverse-proxy hops to trust for the client address (rate limiting). 1 on Cloud Run,
# 0 when clients connect directly. Default: 0.
TRUST_PROXY_HOPS=0

# Version string reported by /healthz and /api/config. Default: the version in backend/package.json.
# The release image sets it to the git tag.
APP_VERSION=

# Where the source of the version you run is published, an http:// or https:// URL. The app's footer links to this
# URL as "Source (MIT)" on every page (it is `sourceUrl` in /api/config), a courtesy to the people who use the
# instance: gcportrait is licensed under the MIT License, which does not ask for the link.
# Default: https://github.com/florianchrometz/gcportrait, the project's repository (a fork changes it:
# docs/contributing.md, Releases), the right target for an unmodified deployment. If you run a modified
# version and publish its source, you can point it there.
SOURCE_URL=

# "true" (exactly) runs a sign-in-free demo (docs/self-host-options.md, "Demo-only instance"): /api/config says
# demoOnly, the routes that call Google are not there, and the app offers the demo organisations only. Then
# OAUTH_CLIENT_ID must be unset and SA_MODE_ENABLED not "true". A value other than "true" or "false" stops start-up.
DEMO_ONLY=

# The legal pages (docs/self-host-options.md, "Legal pages: link or serve"), each either linked or served, not both.
# Linked: the https:// address of an Impressum and of a privacy notice you publish elsewhere, such as on your own
# website (no user name or password in it, at most 2048 characters), reported in /api/config as legal.impressumUrl and
# legal.privacyUrl for the app's footer. Unset: not linked.
LEGAL_IMPRESSUM_URL=
LEGAL_PRIVACY_URL=

# Served: the texts shown at /impressum and /privacy and linked from the footer, from a directory holding
# impressum.md and/or privacy.md (UTF-8 Markdown, at most 64 KiB each). Keep it outside the repository: such texts
# name a person and an address. Unset: no texts. A text next to a link for the same page stops start-up.
LEGAL_DIR=

# The same texts as one JSON object of base64 strings, {"impressum":"...","privacy":"..."}; infra/deploy.sh
# --legal-dir writes it on Cloud Run. Set LEGAL_DIR or LEGAL_BUNDLE, not both.
LEGAL_BUNDLE=

# The render API, POST /api/render (docs/api.md): "true" or "false", on when unset (never on a demo-only
# instance). Its limits: assets per render (1 to 1000000, default 60000), pixels per PNG (1000000 to 134217728,
# default 67108864; the rasteriser takes about 10 bytes a pixel), the time from the start of a render to its answer
# in ms (10000 to 3600000, default 300000; keep it below the platform's request timeout), and the size of an
# uploaded file in bytes (1048576 to 1073741824, default 26214400).
RENDER_API=
RENDER_MAX_ASSETS=
RENDER_MAX_PIXELS=
RENDER_TIMEOUT_MS=
RENDER_MAX_BODY_BYTES=
